---
import { Image } from 'astro:assets';
import bannerImg from '../assets/banner.webp';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PostNavigation from '../components/PostNavigation.astro';
import Comments from '../components/Comments.astro';
import { SITE_NAME } from '../consts';
import { formatDate, getReadingTime, slugify } from '../utils/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { post, headings, prev, next } = Astro.props;
const { data } = post;

const readingTime = getReadingTime(post.body);
const categorySlug = slugify(data.category);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(bannerImg.src, Astro.site);

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  inLanguage: 'bn',
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate
    ? { dateModified: data.updatedDate.toISOString() }
    : { dateModified: data.pubDate.toISOString() }),
  author: {
    '@type': 'Organization',
    name: data.author || SITE_NAME,
    url: Astro.site?.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: Astro.site?.toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  image: ogImageURL.toString(),
  keywords: data.tags.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'হোম',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: data.category,
      item: new URL(`/category/${categorySlug}/`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: canonicalURL.toString(),
    },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  structuredData={[blogPostingLd, breadcrumbLd]}
>
  <article class="mx-auto max-w-5xl">
    <!-- Breadcrumb -->
    <nav aria-label="ব্রেডক্রাম্ব" class="mb-6 text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-foreground hover:underline">হোম</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            href={`/category/${categorySlug}/`}
            class="hover:text-foreground hover:underline">{data.category}</a
          >
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="max-w-55 truncate text-foreground sm:max-w-md">
          {data.title}
        </li>
      </ol>
    </nav>

    <div class="mx-auto max-w-3xl">
        <!-- Article header -->
        <header class="mb-8">
          <a
            href={`/category/${categorySlug}/`}
            class="inline-block rounded-full border border-border bg-muted px-3 py-1 text-sm font-medium text-muted-foreground no-underline transition-all duration-200 hover:border-primary hover:text-primary hover:shadow-sm"
          >
            {data.category}
          </a>
          <h1
            class="mt-4 text-3xl leading-snug font-bold text-foreground sm:text-4xl sm:leading-snug"
          >
            {data.title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
            {data.description}
          </p>
          <div
            class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-border pb-6 text-sm text-muted-foreground"
          >
            <span class="inline-flex items-center gap-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
                aria-hidden="true"
                ><rect width="18" height="18" x="3" y="4" rx="2" ry="2"
                ></rect><line x1="16" x2="16" y1="2" y2="6"></line><line
                  x1="8"
                  x2="8"
                  y1="2"
                  y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg
              >
              <time datetime={data.pubDate.toISOString()}
                >{formatDate(data.pubDate)}</time
              >
            </span>
            {
              data.updatedDate && (
                <span>
                  (আপডেট:{' '}
                  <time datetime={data.updatedDate.toISOString()}>
                    {formatDate(data.updatedDate)}
                  </time>
                  )
                </span>
              )
            }
            <span aria-hidden="true">•</span>
            <span>{readingTime} মিনিট পড়া</span>
          </div>
        </header>

        <!-- Featured image -->
        {
          data.heroImage && (
            <figure class="mb-10">
              <Image
                src={data.heroImage}
                alt={data.heroImageAlt ?? data.title}
                width={1200}
                height={675}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="aspect-video w-full rounded-xl border border-border object-cover transition-shadow hover:shadow-lg"
              />
            </figure>
          )
        }

        <!-- Collapsible TOC -->
        <TableOfContents headings={headings} />

        <!-- Article content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Tags -->
        {
          data.tags.length > 0 && (
            <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-border pt-6">
              <span class="text-sm font-semibold text-foreground">ট্যাগ:</span>
              {data.tags.map((tag) => (
                <a
                  href={`/tags/${slugify(tag)}/`}
                  class="rounded-full border border-border bg-muted px-3 py-1 text-sm text-muted-foreground no-underline transition-all duration-200 hover:border-primary hover:text-primary hover:shadow-sm"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        <!-- Share / copy -->
        <ShareButtons title={data.title} />
    </div>

    <!-- Previous / Next posts -->
    <div class="mx-auto max-w-3xl">
      <PostNavigation prev={prev} next={next} />
      <Comments />
    </div>
  </article>

  <!-- Enhance Shiki code blocks: language label + copy button (no framework) -->
  <script>
    function enhanceCodeBlocks() {
      document
        .querySelectorAll<HTMLPreElement>('pre.astro-code')
        .forEach((pre) => {
          if (pre.parentElement?.classList.contains('code-block')) return;

          const lang = pre.getAttribute('data-language') ?? 'code';
          const wrapper = document.createElement('div');
          wrapper.className = 'code-block';

          const header = document.createElement('div');
          header.className = 'code-block-header';

          const label = document.createElement('span');
          label.textContent = lang;
          label.setAttribute('aria-hidden', 'true');

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-block-copy';
          button.textContent = 'কপি করুন';
          button.setAttribute('aria-label', `${lang} কোড কপি করুন`);

          button.addEventListener('click', async () => {
            const code =
              pre.querySelector('code')?.innerText ?? pre.innerText ?? '';
            let ok = false;
            try {
              await navigator.clipboard.writeText(code);
              ok = true;
            } catch {
              // Fallback for older browsers / non-secure contexts
              const ta = document.createElement('textarea');
              ta.value = code;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try {
                ok = document.execCommand('copy');
              } catch {
                ok = false;
              }
              ta.remove();
            }
            button.textContent = ok ? 'কপি হয়েছে!' : 'কপি ব্যর্থ হয়েছে';
            window.setTimeout(() => {
              button.textContent = 'কপি করুন';
            }, 2000);
          });

          header.append(label, button);
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.append(header, pre);
        });
    }

    enhanceCodeBlocks();
    document.addEventListener('astro:after-swap', enhanceCodeBlocks);
  </script>
</BaseLayout>
