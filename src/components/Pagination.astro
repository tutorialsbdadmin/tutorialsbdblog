---
interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  numPages: number;
  basePath: string;
}

const { prevUrl, nextUrl, currentPage, numPages, basePath } = Astro.props;

if (numPages <= 1) return null;

function getPages(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const pages: (number | '...')[] = [1];

  if (current > 3) pages.push('...');

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) pages.push(i);

  if (current < total - 2) pages.push('...');

  pages.push(total);
  return pages;
}

const pages = getPages(currentPage, numPages);

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) return basePath;
  return `${basePath}${pageNum}/`;
}
---

<nav aria-label="পৃষ্ঠার নেভিগেশন" class="mt-10">
  <ul class="flex flex-wrap items-center justify-center gap-1.5">
    {prevUrl && (
      <li>
        <a
          href={prevUrl}
          class="inline-flex items-center gap-1 rounded-md border border-border bg-muted px-3 py-1.5 text-sm text-muted-foreground no-underline transition-colors hover:border-primary hover:text-primary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          পূর্ববর্তী
        </a>
      </li>
    )}

    {pages.map((p) => (
      <li>
        {p === '...' ? (
          <span class="px-2 py-1.5 text-sm text-muted-foreground" aria-hidden="true">…</span>
        ) : (
          <a
            href={getPageUrl(p)}
            class:list={[
              'inline-flex size-9 items-center justify-center rounded-md border text-sm font-medium no-underline transition-colors',
              p === currentPage
                ? 'border-primary bg-primary text-primary-foreground shadow-sm'
                : 'border-border bg-muted text-muted-foreground hover:border-primary hover:text-primary hover:shadow-sm',
            ]}
            aria-current={p === currentPage ? 'page' : undefined}
          >
            {p}
          </a>
        )}
      </li>
    ))}

    {nextUrl && (
      <li>
        <a
          href={nextUrl}
          class="inline-flex items-center gap-1 rounded-md border border-border bg-muted px-3 py-1.5 text-sm text-muted-foreground no-underline transition-colors hover:border-primary hover:text-primary"
        >
          পরবর্তী
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </li>
    )}
  </ul>
</nav>
