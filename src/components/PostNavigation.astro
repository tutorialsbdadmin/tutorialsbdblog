---
interface Props {
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav aria-label="পোস্ট নেভিগেশন" class="mt-12 grid grid-cols-1 gap-4 border-t border-border pt-8 sm:grid-cols-2">
      {prev && (
        <a
          href={`/posts/${prev.id}/`}
          class="group flex flex-col rounded-lg border border-border p-4 no-underline transition-all duration-200 hover:border-primary hover:shadow-sm"
        >
          <span class="text-xs text-muted-foreground">পূর্ববর্তী পোস্ট</span>
          <span class="mt-1 text-sm font-semibold text-foreground transition-colors group-hover:text-primary line-clamp-2">
            {prev.title}
          </span>
        </a>
      )}
      {next && (
        <a
          href={`/posts/${next.id}/`}
          class="group flex flex-col rounded-lg border border-border p-4 text-right no-underline transition-all duration-200 hover:border-primary hover:shadow-sm sm:col-start-2"
        >
          <span class="text-xs text-muted-foreground">পরবর্তী পোস্ট</span>
          <span class="mt-1 text-sm font-semibold text-foreground transition-colors group-hover:text-primary line-clamp-2">
            {next.title}
          </span>
        </a>
      )}
    </nav>
  )
}
