---
import { SOCIAL_LINKS } from '../consts';

interface Props {
  /** 'row' = horizontal icon list, 'boxed' = labeled links for homepage section */
  variant?: 'row' | 'labeled';
  class?: string;
}

const { variant = 'row', class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  facebook:
    '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>',
  youtube:
    '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>',
};
---

<ul class:list={['flex items-center gap-2', className]} role="list">
  {
    SOCIAL_LINKS.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`TutorialsBD ${link.name} পেজ (নতুন ট্যাবে খুলবে)`}
          class:list={[
            'inline-flex items-center gap-2 rounded-md text-muted-foreground no-underline transition-all duration-200 hover:bg-muted hover:text-foreground hover:shadow-sm',
            variant === 'row' ? 'size-10 justify-center' : 'px-3 py-2',
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
            set:html={icons[link.icon]}
          />
          {variant === 'labeled' && (
            <span class="text-sm font-medium">{link.name}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>
