<section class="not-prose mt-10 rounded-xl border border-border bg-muted/50 p-6 sm:p-8">
  <div class="mx-auto max-w-lg text-center">
    <h2 class="text-xl font-bold text-foreground">নিউজলেটার</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      নতুন পোস্ট সরাসরি ই-মেইলে পেতে সাবস্ক্রাইব করুন—কথা দিচ্ছি, কোনো স্প্যাম নয়!
    </p>
    <form
      class="mt-5 flex flex-col gap-3 sm:flex-row"
      action="https://buttondown.com/api/emails/embed-subscribe/tutorialsbd"
      method="post"
    >
      <label for="newsletter-email" class="sr-only">ইমেইল ঠিকানা</label>
      <input
        type="email"
        id="newsletter-email"
        name="email"
        required
        placeholder="আপনার ইমেইল ঠিকানা"
        class="flex-1 rounded-lg border border-border bg-card px-4 py-2.5 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary"
      />
      <button
        type="submit"
        class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:opacity-90"
      >
        সাবস্ক্রাইব
      </button>
    </form>
  </div>
</section>
