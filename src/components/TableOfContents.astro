---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = headings.filter((h) => h.depth === 2);
---

{
  toc.length > 0 && (
    <div class="not-prose mb-8">
      <div class="rounded-lg border border-border bg-muted/50 p-4" style="box-shadow: var(--shadow-sm);">
        <details open>
          <summary class="flex cursor-pointer items-center gap-2 text-sm font-semibold tracking-wide text-foreground select-none">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="toc-chevron size-4 shrink-0 transition-transform duration-200"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
            টেবিল অফ কনটেন্ট
          </summary>
          <nav aria-label="টেবিল অফ কনটেন্ট" class="mt-3">
            <ul class="space-y-0.5">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.slug}`} class="toc-link text-sm">
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </div>
  )
}

