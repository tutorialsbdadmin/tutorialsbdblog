---
import { NAV_LINKS } from '../consts';
---

<div class="md:hidden" data-mobile-menu>
  <button
    type="button"
    class="inline-flex size-10 items-center justify-center rounded-md text-muted-foreground transition-all duration-200 hover:bg-muted hover:text-foreground"
    aria-label="মেনু খুলুন"
    aria-expanded="false"
    aria-controls="mobile-nav"
    data-menu-button
  >
    <!-- Hamburger -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
      aria-hidden="true"
      data-icon-open
      ><line x1="4" x2="20" y1="6" y2="6"></line><line
        x1="4"
        x2="20"
        y1="12"
        y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
    >
    <!-- Close (X) -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden size-5"
      aria-hidden="true"
      data-icon-close
      ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
    >
  </button>

  <nav
    id="mobile-nav"
    aria-label="মোবাইল নেভিগেশন"
    class="absolute inset-x-0 top-full hidden border-b border-border bg-card px-4 py-3 shadow-lg"
    data-menu-panel
  >
    <ul class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-[1.05rem] font-medium text-foreground no-underline transition-all duration-200 hover:bg-muted"
              aria-current={
                Astro.url.pathname === link.href ? 'page' : undefined
              }
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-mobile-menu]')
    .forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>(
        '[data-menu-button]',
      );
      const panel = root.querySelector<HTMLElement>('[data-menu-panel]');
      const iconOpen = root.querySelector<SVGElement>('[data-icon-open]');
      const iconClose = root.querySelector<SVGElement>(
        '[data-icon-close]',
      );
      if (!button || !panel || !iconOpen || !iconClose) return;

      const setOpen = (open: boolean) => {
        panel.classList.toggle('hidden', !open);
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute(
          'aria-label',
          open ? 'মেনু বন্ধ করুন' : 'মেনু খুলুন',
        );
      };

      button.addEventListener('click', () => {
        setOpen(panel.classList.contains('hidden'));
      });

      panel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.classList.contains('hidden')) {
          setOpen(false);
          button.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (
          !root.contains(event.target as Node) &&
          !panel.classList.contains('hidden')
        ) {
          setOpen(false);
        }
      });
    });
</script>
